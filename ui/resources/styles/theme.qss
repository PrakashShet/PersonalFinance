/* Personal Finance Manager - stylesheet template.
   Dollar-prefixed tokens are filled in by ui/theme/manager.py from ui/theme/tokens.py,
   once for light and once for dark. Never put a literal colour here. */

/* ---- Base ------------------------------------------------------------ */
QWidget {
    color: $text;
}
QMainWindow, QDialog {
    background-color: $bg;
}
QDialog {
    background-color: $surface;
}
QLabel {
    background: transparent;
}
QStackedWidget#content {
    background-color: $bg;
}
QScrollArea, QScrollArea > QWidget > QWidget {
    background: transparent;
    border: none;
}
QSplitter::handle {
    background: transparent;
}
QSplitter::handle:horizontal { width: 14px; }
QSplitter::handle:vertical { height: 14px; }

/* ---- Typography roles --------------------------------------------------- */
QLabel#pageTitle { font-size: 22px; font-weight: 600; color: $text; }
QLabel#pageSubtitle { font-size: 13px; color: $text_muted; }
QLabel#sectionTitle { font-size: 15px; font-weight: 600; color: $text; }
QLabel#cardTitle { font-size: 14px; font-weight: 600; color: $text; }
QLabel#cardSubtitle { font-size: 12px; color: $text_muted; }
QLabel#detailTitle { font-size: 19px; font-weight: 600; color: $text; }
QLabel#muted { color: $text_muted; }
QLabel#small { font-size: 12px; color: $text_muted; }
QLabel#faint { font-size: 12px; color: $text_faint; }
QLabel#kpiLabel { font-size: 12px; font-weight: 500; color: $text_muted; }
QLabel#kpiValue { font-size: 22px; font-weight: 600; color: $text; }
QLabel#kpiHint { font-size: 12px; color: $text_muted; }
QLabel#heroValue { font-size: 36px; font-weight: 600; color: $text; }
QLabel#statLabel { font-size: 12px; color: $text_muted; }
QLabel#statValue { font-size: 14px; font-weight: 600; color: $text; }
QLabel#fieldHint { font-size: 12px; color: $text_muted; }
QLabel#brandName { font-size: 15px; font-weight: 700; color: $text; }
QLabel#brandSub { font-size: 11px; color: $text_muted; }
QLabel#navSection { font-size: 11px; font-weight: 600; color: $text_faint; padding: 10px 12px 4px 12px; }
QLabel#saveStatus { font-size: 12px; color: $text_muted; }
QLabel#saveStatus[tone="negative"] { color: $negative; }
QLabel#rowTitle { font-size: 13px; font-weight: 500; color: $text; }
QLabel#rowMeta { font-size: 12px; color: $text_muted; }
QLabel#rowValue { font-size: 13px; font-weight: 600; color: $text; }
QLabel#emptyTitle { font-size: 15px; font-weight: 600; color: $text; }
QLabel#emptyText { font-size: 13px; color: $text_muted; }

QLabel[tone="positive"] { color: $positive; }
QLabel[tone="negative"] { color: $negative; }
QLabel[tone="warning"] { color: $warning; }
QLabel[tone="info"] { color: $info; }
QLabel[tone="accent"] { color: $accent_text; }
QLabel[tone="muted"] { color: $text_muted; }

/* A role rule (QLabel#statValue) outranks a bare [tone] rule, so every role
   that takes a tone repeats the tones here - without this they never show. */
QLabel#kpiValue[tone="positive"], QLabel#kpiHint[tone="positive"], QLabel#statValue[tone="positive"],
QLabel#rowValue[tone="positive"], QLabel#tileValue[tone="positive"], QLabel#small[tone="positive"],
QLabel#fieldHint[tone="positive"] { color: $positive; }
QLabel#kpiValue[tone="negative"], QLabel#kpiHint[tone="negative"], QLabel#statValue[tone="negative"],
QLabel#rowValue[tone="negative"], QLabel#tileValue[tone="negative"], QLabel#small[tone="negative"],
QLabel#fieldHint[tone="negative"] { color: $negative; }
QLabel#kpiValue[tone="warning"], QLabel#kpiHint[tone="warning"], QLabel#statValue[tone="warning"],
QLabel#rowValue[tone="warning"], QLabel#tileValue[tone="warning"], QLabel#small[tone="warning"],
QLabel#fieldHint[tone="warning"] { color: $warning; }
QLabel#kpiValue[tone="info"], QLabel#kpiHint[tone="info"], QLabel#statValue[tone="info"],
QLabel#rowValue[tone="info"], QLabel#tileValue[tone="info"], QLabel#small[tone="info"],
QLabel#fieldHint[tone="info"] { color: $info; }
QLabel#kpiValue[tone="accent"], QLabel#kpiHint[tone="accent"], QLabel#statValue[tone="accent"],
QLabel#rowValue[tone="accent"], QLabel#tileValue[tone="accent"], QLabel#small[tone="accent"],
QLabel#fieldHint[tone="accent"] { color: $accent_text; }

/* ---- Badges ------------------------------------------------------------ */
QLabel#badge {
    font-size: 11px;
    font-weight: 600;
    padding: 2px 8px;
    border-radius: 9px;
    color: $neutral;
    background-color: $neutral_soft;
}
QLabel#badge[tone="accent"]   { color: $accent_text; background-color: $accent_soft; }
QLabel#badge[tone="positive"] { color: $positive; background-color: $positive_soft; }
QLabel#badge[tone="negative"] { color: $negative; background-color: $negative_soft; }
QLabel#badge[tone="warning"]  { color: $warning; background-color: $warning_soft; }
QLabel#badge[tone="info"]     { color: $info; background-color: $info_soft; }

/* ---- Cards & panels ---------------------------------------------------- */
QFrame#card, QFrame#kpiCard, QFrame#detailCard {
    background-color: $surface;
    border: 1px solid $border;
    border-radius: 12px;
}
QFrame#sectionBlock {
    background-color: $surface_alt;
    border: 1px solid $border;
    border-radius: 10px;
}
QFrame#divider {
    background-color: $border;
    border: none;
    max-height: 1px;
    min-height: 1px;
}
QFrame#row {
    background: transparent;
    border: none;
    border-radius: 8px;
}
QFrame#row:hover {
    background-color: $surface_hover;
}

/* ---- Banners ------------------------------------------------------------ */
QFrame#banner {
    border-radius: 10px;
    border: 1px solid $neutral_border;
    background-color: $neutral_soft;
}
QFrame#banner[tone="info"]     { border-color: $info_border; background-color: $info_soft; }
QFrame#banner[tone="warning"]  { border-color: $warning_border; background-color: $warning_soft; }
QFrame#banner[tone="negative"] { border-color: $negative_border; background-color: $negative_soft; }
QFrame#banner[tone="positive"] { border-color: $positive_border; background-color: $positive_soft; }
QLabel#bannerText { font-size: 13px; color: $text; }

/* ---- List tiles -------------------------------------------------------- */
QFrame#tile {
    background-color: $surface;
    border: 1px solid $border;
    border-radius: 12px;
}
QFrame#tile:hover {
    border-color: $border_strong;
    background-color: $surface_alt;
}
QFrame#tile[selected="true"] {
    border: 1px solid $accent;
    background-color: $accent_soft;
}
QFrame#tile[muted="true"] QLabel#tileTitle { color: $text_muted; }
QLabel#tileTitle { font-size: 14px; font-weight: 600; color: $text; }
QLabel#tileMeta { font-size: 12px; color: $text_muted; }
QLabel#tileValue { font-size: 14px; font-weight: 600; color: $text; }
QLabel#tileIcon {
    background-color: $neutral_soft;
    border-radius: 10px;
}
QFrame#tile[selected="true"] QLabel#tileIcon { background-color: $surface; }

/* ---- Sidebar ----------------------------------------------------------- */
QFrame#sidebar {
    background-color: $sidebar;
    border: none;
    border-right: 1px solid $border;
}
QListWidget#nav {
    background: transparent;
    border: none;
    outline: 0;
    font-size: 13px;
}
QListWidget#nav::item {
    padding: 8px 10px;
    margin: 1px 0px;
    border-radius: 8px;
    color: $text_secondary;
}
QListWidget#nav::item:hover {
    background-color: $surface_hover;
}
QListWidget#nav::item:selected {
    background-color: $accent_soft;
    color: $accent_text;
}
QLabel#brandMark {
    background-color: $accent;
    border-radius: 9px;
}

/* ---- Buttons ----------------------------------------------------------- */
QPushButton, QToolButton {
    background-color: $surface;
    color: $text;
    border: 1px solid $border_strong;
    border-radius: 8px;
    padding: 7px 14px;
    font-size: 13px;
    font-weight: 500;
}
QToolButton { padding: 6px 8px; }
QPushButton:hover, QToolButton:hover {
    background-color: $surface_hover;
}
QPushButton:pressed, QToolButton:pressed {
    background-color: $border;
}
QPushButton:disabled, QToolButton:disabled {
    color: $text_faint;
    border-color: $border;
    background-color: $surface_alt;
}
QPushButton:focus, QToolButton:focus {
    border-color: $focus;
}
QPushButton::menu-indicator { width: 0px; }

QPushButton[kind="primary"] {
    background-color: $accent;
    color: $on_accent;
    border: 1px solid $accent;
}
QPushButton[kind="primary"]:hover { background-color: $accent_hover; border-color: $accent_hover; }
QPushButton[kind="primary"]:pressed { background-color: $accent_pressed; border-color: $accent_pressed; }
QPushButton[kind="primary"]:disabled {
    background-color: $accent_soft;
    border-color: $accent_soft;
    color: $text_faint;
}
QPushButton[kind="danger"] {
    color: $negative;
    border-color: $negative_border;
    background-color: $surface;
}
QPushButton[kind="danger"]:hover { background-color: $negative_soft; }
QPushButton[kind="danger"]:disabled {
    color: $text_faint;
    border-color: $border;
    background-color: $surface_alt;
}
QPushButton[kind="ghost"], QToolButton[kind="ghost"] {
    background: transparent;
    border: 1px solid transparent;
}
QPushButton[kind="ghost"]:hover, QToolButton[kind="ghost"]:hover {
    background-color: $surface_hover;
}
QPushButton[kind="link"] {
    background: transparent;
    border: none;
    padding: 2px 0px;
    color: $accent_text;
    font-weight: 600;
}
QPushButton[kind="link"]:hover { text-decoration: underline; }
QPushButton[size="small"] { padding: 4px 10px; font-size: 12px; }

/* Segmented control */
QFrame#segmented {
    background-color: $surface_alt;
    border: 1px solid $border;
    border-radius: 9px;
}
QPushButton#segment {
    background: transparent;
    border: 1px solid transparent;
    border-radius: 7px;
    padding: 5px 12px;
    color: $text_muted;
    font-weight: 500;
}
QPushButton#segment:hover { color: $text; }
QPushButton#segment:checked {
    background-color: $surface;
    border: 1px solid $border_strong;
    color: $text;
    font-weight: 600;
}

/* ---- Inputs ------------------------------------------------------------ */
QLineEdit, QComboBox, QDateEdit, QSpinBox, QDoubleSpinBox, QPlainTextEdit, QTextEdit {
    background-color: $surface;
    color: $text;
    border: 1px solid $border_strong;
    border-radius: 8px;
    padding: 6px 10px;
    selection-background-color: $selection;
    selection-color: $text;
    min-height: 20px;
}
QLineEdit:hover, QComboBox:hover, QDateEdit:hover, QSpinBox:hover, QDoubleSpinBox:hover,
QPlainTextEdit:hover, QTextEdit:hover {
    border-color: $text_faint;
}
QLineEdit:focus, QComboBox:focus, QDateEdit:focus, QSpinBox:focus, QDoubleSpinBox:focus,
QPlainTextEdit:focus, QTextEdit:focus {
    border: 1px solid $focus;
}
QLineEdit:disabled, QComboBox:disabled, QDateEdit:disabled, QSpinBox:disabled,
QDoubleSpinBox:disabled, QPlainTextEdit:disabled {
    background-color: $surface_alt;
    color: $text_faint;
    border-color: $border;
}
QDoubleSpinBox#amountInput {
    font-size: 20px;
    font-weight: 600;
    padding: 8px 12px;
}
QComboBox::drop-down, QDateEdit::drop-down {
    border: none;
    width: 26px;
}
QComboBox::down-arrow, QDateEdit::down-arrow {
    image: url($img_chevron_down);
    width: 14px;
    height: 14px;
}
QComboBox QAbstractItemView {
    background-color: $surface;
    border: 1px solid $border;
    border-radius: 8px;
    padding: 4px;
    selection-background-color: $surface_hover;
    selection-color: $text;
    outline: 0;
}
QSpinBox::up-button, QDoubleSpinBox::up-button, QDateEdit::up-button {
    subcontrol-origin: border;
    subcontrol-position: top right;
    width: 20px;
    border: none;
    background: transparent;
}
QSpinBox::down-button, QDoubleSpinBox::down-button, QDateEdit::down-button {
    subcontrol-origin: border;
    subcontrol-position: bottom right;
    width: 20px;
    border: none;
    background: transparent;
}
QSpinBox::up-arrow, QDoubleSpinBox::up-arrow {
    image: url($img_chevron_up);
    width: 10px;
    height: 10px;
}
QSpinBox::down-arrow, QDoubleSpinBox::down-arrow {
    image: url($img_chevron_down);
    width: 10px;
    height: 10px;
}
QSpinBox::up-button:hover, QDoubleSpinBox::up-button:hover,
QSpinBox::down-button:hover, QDoubleSpinBox::down-button:hover {
    background-color: $surface_hover;
}

QCheckBox, QRadioButton {
    spacing: 8px;
    background: transparent;
}
QCheckBox::indicator, QRadioButton::indicator {
    width: 16px;
    height: 16px;
    border: 1px solid $border_strong;
    background-color: $surface;
}
QCheckBox::indicator { border-radius: 5px; }
QRadioButton::indicator { border-radius: 8px; }
QCheckBox::indicator:hover, QRadioButton::indicator:hover { border-color: $focus; }
QCheckBox::indicator:checked {
    background-color: $accent;
    border-color: $accent;
    image: url($img_check);
}
QRadioButton::indicator:checked {
    background-color: $surface;
    border: 5px solid $accent;
}

/* ---- Tables ------------------------------------------------------------ */
QTableView, QTableWidget, QTreeView, QListView {
    background-color: $surface;
    alternate-background-color: $surface_alt;
    border: none;
    gridline-color: $border;
    selection-background-color: $selection;
    selection-color: $text;
    outline: 0;
}
QTableView::item, QTableWidget::item {
    padding: 0px 10px;
    border-bottom: 1px solid $border;
}
QTableView::item:hover, QTableWidget::item:hover {
    background-color: $surface_hover;
}
QTableView::item:selected, QTableWidget::item:selected {
    background-color: $selection;
    color: $text;
}
QHeaderView {
    background-color: $surface;
    border: none;
}
QHeaderView::section {
    background-color: $surface;
    color: $text_muted;
    font-size: 12px;
    font-weight: 600;
    padding: 8px 10px;
    border: none;
    border-bottom: 1px solid $border;
}
QTableCornerButton::section {
    background-color: $surface;
    border: none;
}

/* ---- Progress ---------------------------------------------------------- */
QProgressBar {
    background-color: $track;
    border: none;
    border-radius: 4px;
    max-height: 8px;
    min-height: 8px;
    text-align: center;
    color: transparent;
}
QProgressBar::chunk { background-color: $accent; border-radius: 4px; }
QProgressBar[tone="positive"]::chunk { background-color: $positive; }
QProgressBar[tone="warning"]::chunk { background-color: $warning; }
QProgressBar[tone="negative"]::chunk { background-color: $negative; }
QProgressBar[size="large"] { max-height: 10px; min-height: 10px; border-radius: 5px; }
QProgressBar[size="large"]::chunk { border-radius: 5px; }

/* ---- Scrollbars -------------------------------------------------------- */
QScrollBar:vertical {
    background: transparent;
    width: 10px;
    margin: 2px;
}
QScrollBar::handle:vertical {
    background: $scroll_handle;
    border-radius: 3px;
    min-height: 32px;
}
QScrollBar::handle:vertical:hover { background: $scroll_handle_hover; }
QScrollBar:horizontal {
    background: transparent;
    height: 10px;
    margin: 2px;
}
QScrollBar::handle:horizontal {
    background: $scroll_handle;
    border-radius: 3px;
    min-width: 32px;
}
QScrollBar::handle:horizontal:hover { background: $scroll_handle_hover; }
QScrollBar::add-line, QScrollBar::sub-line { width: 0px; height: 0px; }
QScrollBar::add-page, QScrollBar::sub-page { background: transparent; }

/* ---- Menus, tooltips, group boxes ------------------------------------------ */
QMenu {
    background-color: $surface;
    border: 1px solid $border;
    border-radius: 10px;
    padding: 6px;
}
QMenu::item {
    padding: 7px 26px 7px 12px;
    border-radius: 6px;
    color: $text;
}
QMenu::item:selected { background-color: $surface_hover; }
QMenu::separator { height: 1px; background: $border; margin: 5px 8px; }
QMenu::icon { padding-left: 8px; }

QToolTip {
    background-color: $tooltip_bg;
    color: $tooltip_text;
    border: none;
    border-radius: 6px;
    padding: 5px 8px;
}

QGroupBox {
    border: 1px solid $border;
    border-radius: 10px;
    margin-top: 16px;
    padding: 12px 10px 10px 10px;
    font-weight: 600;
}
QGroupBox::title {
    subcontrol-origin: margin;
    left: 12px;
    padding: 0 4px;
    color: $text_secondary;
}

/* ---- Toast ------------------------------------------------------------- */
QLabel#toast {
    background-color: $tooltip_bg;
    color: $tooltip_text;
    border-radius: 10px;
    padding: 10px 16px;
    font-size: 13px;
    font-weight: 500;
}

/* ---- Calendar popup ---------------------------------------------------- */
QCalendarWidget QWidget#qt_calendar_navigationbar {
    background-color: $surface;
    border-bottom: 1px solid $border;
}
QCalendarWidget QToolButton {
    border: none;
    background: transparent;
    color: $text;
    font-weight: 600;
    padding: 4px 8px;
}
QCalendarWidget QToolButton:hover { background-color: $surface_hover; }
QCalendarWidget QAbstractItemView {
    background-color: $surface;
    selection-background-color: $accent;
    selection-color: $on_accent;
}
