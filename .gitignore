# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# IDE / assistants
.vscode/
.idea/
*.swp
# Local Claude Code settings and the activated copy of docs/skills (the source).
.claude/
# Values you've confirmed are not personal, for tools/privacy_scan.py (they come
# from your data, so the list itself stays local).
.privacy-ignore

# Runtime
logs/*.log
data/app.db
data/app.db-*
# The single-instance lock: held while the app runs; holds the PID and computer name.
data/app.lock
*.lock
data/cache/*
!data/cache/.gitkeep

# OS
.DS_Store
Thumbs.db

# PyInstaller. build/ is scratch. dist/ is ignored except the released app
# folder (the .exe and _internal) - never anything an app writes beside itself:
# builds before 1.0 kept their data, backups and app.db in data/ there.
build/
dist/*
!dist/PersonalFinanceManager/
dist/PersonalFinanceManager/data/
dist/PersonalFinanceManager/logs/
# *.py[cod] above also matches .pyd - the app's compiled modules (QtCore.pyd...).
!dist/PersonalFinanceManager/**/*.pyd

# Test
.pytest_cache/
.coverage
htmlcov/

# Personal financial data never goes into the code repo — it has its own
# backup system (data/user/backups). Pushing this repo must never leak finances.
data/store/
data/user/
logs/
shots/
